{
 "lookalike": {
  "book": [
   "near:accountant.testnet",
   "near:landlord.testnet"
  ],
  "cases": [
   {
    "key": "near:accountant1.testnet",
    "expect": "flag:name_edit",
    "why": "one inserted digit"
   },
   {
    "key": "near:acc0unt4nt.testnet",
    "expect": "flag:name_edit",
    "why": "two digit-for-letter swaps"
   },
   {
    "key": "near:acc0unt4n7.testnet",
    "expect": "clear",
    "why": "three digit-for-letter swaps, edit distance 3"
   },
   {
    "key": "near:1and1ord.testnet",
    "expect": "flag:name_edit",
    "why": "two swaps in landlord"
   },
   {
    "key": "near:1and10rd.testnet",
    "expect": "clear",
    "why": "three swaps in landlord"
   },
   {
    "key": "near:accountant.near",
    "expect": "clear",
    "why": "same name under another top-level account"
   },
   {
    "key": "near:accountant-billing.testnet",
    "expect": "clear",
    "why": "a plausible suffix"
   },
   {
    "key": "near:my-accountant.testnet",
    "expect": "clear",
    "why": "a plausible prefix"
   },
   {
    "key": "near:a-c-c-o-u-n-t-a-n-t.testnet",
    "expect": "flag:name_separator",
    "why": "separators only"
   },
   {
    "key": "near:accountant.testnet.evil-ops.testnet",
    "expect": "flag:name_subaccount",
    "why": "a deeper name that starts with the book name"
   },
   {
    "key": "near:accountantt.testnet",
    "expect": "flag:name_edit",
    "why": "one repeated letter"
   },
   {
    "key": "near:rnarket.testnet",
    "expect": "clear",
    "why": "a name that is not near any book entry (control)"
   }
  ]
 },
 "counterparty": [
  {
   "name": "payee created on the day",
   "key": "near:evil-ops.testnet",
   "seen": "young",
   "expect": "counterparty_new"
  },
  {
   "name": "payee account never created",
   "key": "near:evil-ops.testnet",
   "seen": "absent",
   "expect": "counterparty_new"
  },
  {
   "name": "payee created more than 7 days before the attack",
   "key": "near:evil-aged.testnet",
   "seen": "established",
   "expect": "none",
   "class": "new residual"
  },
  {
   "name": "EVM address with no history",
   "key": "evm:84532:0x2527d02599ba641c19fea793cd0f167589a0f10d",
   "seen": {
    "nonce": "0",
    "balance": "0",
    "hasCode": false
   },
   "expect": "counterparty_new"
  },
  {
   "name": "EVM address funded with one wei by the attacker",
   "key": "evm:84532:0x2527d02599ba641c19fea793cd0f167589a0f10d",
   "seen": {
    "nonce": "0",
    "balance": "1",
    "hasCode": false
   },
   "expect": "none",
   "class": "new residual"
  },
  {
   "name": "lookup fails",
   "key": "near:evil-ops.testnet",
   "seen": "throw",
   "expect": "counterparty_unverified"
  }
 ],
 "x402": {
  "base": "fixtures/x402-live/live-usdc.json",
  "cases": [
   {
    "name": "requirement as served",
    "set": {},
    "expect": "ok"
   },
   {
    "name": "payTo in another case",
    "set": {
     "accepts.0.payTo": "0x209693bc6afc0c5328ba36faf03c514ef312287c"
    },
    "expect": "ok"
   },
   {
    "name": "payTo another address",
    "set": {
     "accepts.0.payTo": "0x1111111111111111111111111111111111111111"
    },
    "expect": "X402Mismatch payTo"
   },
   {
    "name": "amount raised after the gate",
    "set": {
     "accepts.0.amount": "10001"
    },
    "expect": "X402Mismatch amount"
   },
   {
    "name": "amount with a leading zero",
    "set": {
     "accepts.0.amount": "010000"
    },
    "expect": "rejected by the schema"
   },
   {
    "name": "amount in unicode digits",
    "set": {
     "accepts.0.amount": "\u0661\u0660\u0660\u0660\u0660"
    },
    "expect": "rejected by the schema"
   },
   {
    "name": "another network",
    "set": {
     "accepts.0.network": "eip155:8453"
    },
    "expect": "X402Mismatch network"
   },
   {
    "name": "another token contract",
    "set": {
     "accepts.0.asset": "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
    },
    "expect": "X402Mismatch asset"
   },
   {
    "name": "upto scheme",
    "set": {
     "accepts.0.scheme": "upto"
    },
    "expect": "X402Mismatch scheme"
   },
   {
    "name": "EIP-712 domain name changed",
    "set": {
     "accepts.0.extra.name": "USD Coin"
    },
    "expect": "ok",
    "why": "the name is only echoed: the contract builds the signing domain from its own registry, so a wrong name makes the facilitator refuse and never changes what was signed"
   },
   {
    "name": "timeout of one year",
    "set": {
     "accepts.0.maxTimeoutSeconds": 31536000
    },
    "expect": "ok",
    "why": "the window is fixed by the contract at 300 s from its block time, whatever the server asks"
   },
   {
    "name": "second entry with another payee, first picked",
    "set": {
     "accepts.1": {
      "scheme": "exact",
      "network": "eip155:84532",
      "amount": "10000",
      "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
      "payTo": "0x1111111111111111111111111111111111111111"
     }
    },
    "expect": "ok",
    "why": "the signed event is compared with the entry picked by index, never with another entry"
   }
  ]
 },
 "intents": [
  {
   "name": "quote as recorded",
   "ops": [],
   "expect": "ok"
  },
  {
   "name": "recipient in upper case",
   "ops": [
    {
     "in": "both",
     "path": "quoteRequest.recipient",
     "value": "0x2527D02599BA641C19FEA793CD0F167589A0F10D"
    }
   ],
   "expect": "ok"
  },
  {
   "name": "recipient swapped in response and echo",
   "ops": [
    {
     "in": "both",
     "path": "quoteRequest.recipient",
     "value": "0x1111111111111111111111111111111111111111"
    }
   ],
   "expect": "RecipientMismatch"
  },
  {
   "name": "recipient swapped in the response only",
   "ops": [
    {
     "in": "response",
     "path": "quoteRequest.recipient",
     "value": "0x1111111111111111111111111111111111111111"
    }
   ],
   "expect": "RequestEchoMismatch"
  },
  {
   "name": "recipient with a trailing space",
   "ops": [
    {
     "in": "both",
     "path": "quoteRequest.recipient",
     "value": "0x2527D02599Ba641c19FEa793cD0F167589a0f10D "
    }
   ],
   "expect": "RecipientMismatch"
  },
  {
   "name": "recipient moved into Intents",
   "ops": [
    {
     "in": "both",
     "path": "quoteRequest.recipientType",
     "value": "INTENTS"
    }
   ],
   "expect": "RecipientNotOnDestinationChain"
  },
  {
   "name": "amount out one below",
   "ops": [
    {
     "in": "response",
     "path": "quote.amountOut",
     "value": "4999999"
    }
   ],
   "expect": "AmountOutBelowAllowed"
  },
  {
   "name": "min amount out one below",
   "ops": [
    {
     "in": "response",
     "path": "quote.minAmountOut",
     "value": "4999999"
    }
   ],
   "expect": "AmountOutBelowAllowed"
  },
  {
   "name": "amount in one above the cap",
   "ops": [
    {
     "in": "response",
     "path": "quote.amountIn",
     "value": "5100001"
    }
   ],
   "expect": "AmountInAboveCap"
  },
  {
   "name": "amount in in unicode digits",
   "ops": [
    {
     "in": "response",
     "path": "quote.amountIn",
     "value": "\u0665\u0660\u0665\u0663\u0669\u0665\u0663"
    }
   ],
   "expect": "MalformedQuote"
  },
  {
   "name": "slippage 101 basis points",
   "ops": [
    {
     "in": "both",
     "path": "quoteRequest.slippageTolerance",
     "value": 101
    }
   ],
   "expect": "SlippageTooWide"
  },
  {
   "name": "refund address swapped",
   "ops": [
    {
     "in": "both",
     "path": "quoteRequest.refundTo",
     "value": "b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2"
    }
   ],
   "expect": "RefundNotOurs"
  },
  {
   "name": "deposit address on a dry quote",
   "ops": [
    {
     "in": "response",
     "path": "quote.depositAddress",
     "value": "c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3"
    }
   ],
   "expect": "UnexpectedDepositAddress"
  },
  {
   "name": "swap type changed to exact input",
   "ops": [
    {
     "in": "response",
     "path": "quoteRequest.swapType",
     "value": "EXACT_INPUT"
    }
   ],
   "expect": "RequestEchoMismatch"
  },
  {
   "name": "destination asset swapped",
   "ops": [
    {
     "in": "response",
     "path": "quoteRequest.destinationAsset",
     "value": "nep141:other.omft.near"
    }
   ],
   "expect": "RequestEchoMismatch"
  },
  {
   "name": "app fee to a third party added to the echoed request",
   "ops": [
    {
     "in": "response",
     "path": "quoteRequest.appFees",
     "value": [
      {
       "recipient": "d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4",
       "fee": 5000
      }
     ]
    }
   ],
   "expect": "UnexpectedFee"
  },
  {
   "name": "deadline moved outside the window",
   "ops": [
    {
     "in": "both",
     "path": "quoteRequest.deadline",
     "value": "2026-12-01T00:00:00.000Z"
    }
   ],
   "expect": "DeadlineOutsideWindow"
  },
  {
   "name": "not dry",
   "ops": [
    {
     "in": "both",
     "path": "quoteRequest.dry",
     "value": false
    }
   ],
   "expect": "NotDry"
  },
  {
   "name": "unknown key nested in a fee entry",
   "ops": [
    {
     "in": "response",
     "path": "quoteRequest.appFees.0.payout",
     "value": "x"
    }
   ],
   "expect": "RequestEchoMismatch"
  },
  {
   "name": "unknown top-level key in the echoed request",
   "ops": [
    {
     "in": "response",
     "path": "quoteRequest.referral",
     "value": "x"
    }
   ],
   "expect": "RequestEchoMismatch"
  },
  {
   "name": "fee of the known recipient raised above its bound",
   "ops": [
    {
     "in": "response",
     "path": "quoteRequest.appFees.0.fee",
     "value": 26
    }
   ],
   "expect": "UnexpectedFee"
  }
 ]
}