# AIR-167: allowed lines of the JSX URL attribute check in scripts/security-pass.sh. One extended regex per line, matched against
# `<file>:<line>:<source text>` of every `href={`, `src={` or `action={` under web/src (fixtures excluded). Add a line only for a
# constant, a route of this app, or a system URL built from a value that matched ^(0x)?[0-9a-f]{64}$.
# An in-document sprite reference built from the typed door state (a closed set of literals), not from text.
^web/src/components/Door\.tsx:[0-9]+:.*<use href=\{`#door-\$\{state\}`\}
# A link to a block explorer: the replay shell passes the server's url through txHref, which keeps it only when it starts with one of the two explorer prefixes of the recorded runs.
^web/src/replay/ReplayShell\.tsx:[0-9]+:.*href=\{txHref\(
# The challenge page builds the link with explorerUrl, which returns null unless the value is a bare transaction hash (letters and digits only).
^web/src/challenge/ChallengeView\.tsx:[0-9]+:.*href=\{url\}
# AIR-310: the static build's page links: `url()` puts the build's base path in front of a route from the constant list STATIC_LINKS.
^web/src/static/StaticPages\.tsx:[0-9]+:.*href=\{url\((l\.path|'')\)\}
# AIR-311: a link to a route of this app: `url()` puts the build's base path in front of a string literal route (letters only, AIR-312 adds an optional ?s=<letters>).
^web/src/[A-Za-z/]+\.tsx:[0-9]+:.*href=\{url\('[a-z]*(\?s=[a-z]+)?'\)\}
# AIR-311: the console tabs: `url()` in front of a route from the constant NAV list of the same file.
^web/src/shell/SiteNav\.tsx:[0-9]+:.*href=\{url\(n\.path\)\}
# AIR-311: the landing loop and its poster: same-origin media files named by string literals in the same file (set after mount).
^web/src/landing/HeroMedia\.tsx:[0-9]+:.*src=\{(poster|(mounted \? )?url\(tall \? 'media/hero-loop-916\.mp4' : 'media/hero-loop\.mp4'\)( : undefined)?)\}
# AIR-311: the prerendered replay summary links a transaction through its own txHref, which keeps a url only when it starts with one of the two explorer prefixes.
^web/src/replay/ReplaySummary\.tsx:[0-9]+:.*href=\{txHref\(
# AIR-311 site loops: the poster and the loop are same-origin media files whose names are built from the `name` prop, a string literal at every call site.
^web/src/landing/SiteLoop\.tsx:[0-9]+:.*src=\{(poster|near \? url\(`media/\$\{name\}\.mp4`\) : undefined)\}
