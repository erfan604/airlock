{
  "name": "@airlock/web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:bench": "pnpm -C ../bench exec tsx src/scripts/web-bench-json.ts && pnpm -C ../bench exec tsx src/scripts/web-bench-json.ts --check ../docs/BENCH.md",
    "build": "pnpm gen:bench && tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"test/**/*.test.{ts,tsx}\"",
    "lint": "eslint src test e2e scripts",
    "e2e": "tsx e2e/run.ts",
    "preview": "vite preview",
    "build:static": "pnpm gen:bench && tsc -p tsconfig.json && vite build --mode static && tsx scripts/export-static.ts && tsx scripts/prerender.tsx",
    "preview:static": "tsx scripts/serve-static.ts"
  },
  "dependencies": {
    "@airlock/runtime": "workspace:*",
    "@hot-labs/near-connect": "0.11.4",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "gsap": "3.15.1",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/mona-sans": "5.3.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
