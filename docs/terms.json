  "parts": [
    {
      "title": "1. What the card and the pool do",
      "clauses": [
        {
          "n": "1.1",
          "kind": "term",
          "text": "Money leaves the card for a payee the issuer put in the card's address book, or goes back to the pool.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-verdict/src/lib.rs", "line": 218, "to": 222, "has": "Rule 9", "name": "rule 9" },
            { "role": "Enforced", "file": "contracts/airlock-policy/src/roles.rs", "line": 78, "to": 109, "has": "on_card_return", "name": "sweep pays the sponsor" },
            { "role": "Proved", "file": "proofs/Verdict.lean", "line": 115, "has": "theorem p3_allowed_in_book", "name": "p3_allowed_in_book" },
            { "role": "Proved", "file": "proofs/Verdict.lean", "line": 12, "has": "theorem allow_iff", "name": "allow_iff" },
            { "role": "Kani", "file": "contracts/airlock-verdict/src/proofs.rs", "line": 127, "has": "fn p03_allowed_recipient_in_book", "name": "p03_allowed_recipient_in_book" },
            { "role": "Shown", "tx": "BNq34shewEcee6haPAuGoaR9fxFz8mXS2fhu6WUpYNpY", "what": "an injected payee held", "row": 373 },
            { "role": "Shown", "tx": "25rQep4msvH5K1YFaJvuEupCEUbqtbQysjgSUy9BcVpW", "what": "a sweep back to the pool", "row": 378 }
          ]
        },
        {
          "n": "1.2",
          "kind": "term",
          "text": "A hijacked agent cannot choose the payee: a payee picked by outside text is held for a person to decide.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-verdict/src/lib.rs", "line": 214, "to": 217, "has": "Rule 8", "name": "rule 8" },
            { "role": "Proved", "file": "proofs/Verdict.lean", "line": 105, "has": "theorem p2_p15_allowed_recipient_trusted", "name": "p2_p15_allowed_recipient_trusted" },
            { "role": "Kani", "file": "contracts/airlock-verdict/src/proofs.rs", "line": 117, "has": "fn p02_p15_allowed_recipient_trust_set", "name": "p02_p15_allowed_recipient_trust_set" },
            { "role": "Shown", "tx": "BNq34shewEcee6haPAuGoaR9fxFz8mXS2fhu6WUpYNpY", "what": "an injected payee held", "row": 373 }
          ]
        },
        {
          "n": "1.3",
          "kind": "term",
          "text": "The borrower cannot approve a payment to an account outside the book; the issuer can override it, and either of them can reject it.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-policy/src/roles.rs", "line": 42, "to": 56, "has": "fn require_settle_role", "name": "require_settle_role" },
            { "role": "Enforced", "file": "contracts/airlock-policy/src/escalation.rs", "line": 491, "to": 495, "has": "approve_and_remember is refused when an approver is set", "name": "the borrower cannot add payees" },
            { "role": "Tested", "file": "contracts/airlock-policy/src/redteam.rs", "line": 519, "has": "fn rt_con_borrower_pays_himself_is_refused", "name": "rt_con_borrower_pays_himself_is_refused" },
            { "role": "Tested", "file": "docs/CLAIMS.md", "line": 38, "has": "| C21 |", "name": "claim C21" },
            { "role": "Shown", "tx": "12VC9dH5f9n7RLRq2h8uDAQDSw2upBwwDygDzjuU69iy", "what": "the borrower's approve of his own account refused", "row": 375 }
          ]
        },
        {
          "n": "1.4",
          "kind": "term",
          "text": "An amount read from outside text is never paid by itself on the card: it is held, because no payee in the card's book has a cap for such amounts. The borrower may approve it for a booked merchant inside what is left of the issuer's task bound and of the merchant's daily limit, and his approve is refused outside them.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-verdict/src/lib.rs", "line": 227, "to": 237, "has": "Rule 11", "name": "rule 11" },
            { "role": "Enforced", "file": "contracts/airlock-policy/src/policy.rs", "line": 297, "has": "strict", "name": "a payee without a cap" },
            { "role": "Enforced", "file": "contracts/airlock-policy/src/escalation.rs", "line": 244, "to": 278, "has": "Reason::OutsideTask | Reason::OverTaskBound | Reason::OverPayeeLimit", "name": "require_approver_within_bounds" },
            { "role": "Tested", "file": "contracts/airlock-policy/src/redteam.rs", "line": 1278, "has": "fn rt_con_approver_cannot_approve_past_the_payee_daily_limit", "name": "rt_con_approver_cannot_approve_past_the_payee_daily_limit" },
            { "role": "Proved", "file": "proofs/Verdict.lean", "line": 123, "has": "theorem p4_p14_p23_untrusted_amount_bounded", "name": "p4_p14_p23_untrusted_amount_bounded" },
            { "role": "Kani", "file": "contracts/airlock-verdict/src/proofs.rs", "line": 137, "has": "fn p04_p14_p23_untrusted_amount_inside_cap_and_budget", "name": "p04_p14_p23_untrusted_amount_inside_cap_and_budget" },
            { "role": "Measured", "file": "docs/BENCH.md", "line": 37, "has": "strict mode A1 in 0 and default mode A2 in 10", "name": "strict mode paid 0 of 250 attack runs, default mode 10 of 250" },
            { "role": "Shown", "tx": "3facSJMXLUG61w8h8AZhA2EREdx17cZ6Wks35vc94tZo", "what": "the book without caps set on the card (epoch 2)" }
          ]
        },
        {
          "n": "1.5",
          "kind": "term",
          "text": "A payment that outside text decided to make is never paid by itself.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-verdict/src/lib.rs", "line": 210, "to": 213, "has": "Rule 7", "name": "rule 7" },
            { "role": "Proved", "file": "proofs/Verdict.lean", "line": 96, "has": "theorem p1_untrusted_pc_not_allowed", "name": "p1_untrusted_pc_not_allowed" },
            { "role": "Kani", "file": "contracts/airlock-verdict/src/proofs.rs", "line": 104, "has": "fn p01_untrusted_pc_never_allowed", "name": "p01_untrusted_pc_never_allowed" },
            { "role": "Shown", "file": "bench/runs/recorded/transcripts/own-S01.A1.1.json", "line": 215, "has": "\"reason\": \"UntrustedTrigger\"", "what": "a bench run held as UntrustedTrigger" }
          ]
        },
        {
          "n": "1.6",
          "kind": "term",
          "text": "Every payment the agent makes or the borrower approves fits the task the issuer signed, and what is left of that task shrinks with each payment. The borrower cannot approve a held payment outside that task, above what is left of its bound, or above the merchant's daily limit; the issuer's override of a payee outside the book is the one approval that passes them (limit 2.1).",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-verdict/src/lib.rs", "line": 202, "to": 209, "has": "Rule 6", "name": "rule 6" },
            { "role": "Enforced", "file": "contracts/airlock-policy/src/escalation.rs", "line": 244, "to": 278, "has": "Reason::OutsideTask | Reason::OverTaskBound | Reason::OverPayeeLimit", "name": "require_approver_within_bounds" },
            { "role": "Tested", "file": "contracts/airlock-policy/src/redteam.rs", "line": 1246, "has": "fn rt_con_approver_cannot_approve_past_the_task_bound", "name": "rt_con_approver_cannot_approve_past_the_task_bound" },
            { "role": "Tested", "file": "contracts/airlock-policy/src/redteam.rs", "line": 1303, "has": "fn rt_con_approver_cannot_approve_past_what_is_left_of_the_task_bound", "name": "rt_con_approver_cannot_approve_past_what_is_left_of_the_task_bound" },
            { "role": "Tested", "file": "contracts/airlock-policy/tests/approver_bounds.rs", "line": 113, "has": "fn lane1_borrower_cannot_approve_past_the_issuers_task_bound", "name": "lane1_borrower_cannot_approve_past_the_issuers_task_bound" },
            { "role": "Tested", "file": "contracts/airlock-policy/tests/approver_bounds.rs", "line": 134, "has": "fn lane1_borrower_cannot_approve_a_payee_outside_the_signed_task", "name": "lane1_borrower_cannot_approve_a_payee_outside_the_signed_task" },
            { "role": "Proved", "file": "proofs/Verdict.lean", "line": 192, "has": "theorem p21_allowed_in_task_bound", "name": "p21_allowed_in_task_bound" },
            { "role": "Kani", "file": "contracts/airlock-verdict/src/proofs.rs", "line": 355, "has": "fn p21_allowed_inside_task_bound", "name": "p21_allowed_inside_task_bound" },
            { "role": "Kani", "file": "contracts/airlock-verdict/src/ledger.rs", "line": 385, "has": "fn l3_task_bound_holds", "name": "l3_task_bound_holds" },
            { "role": "Shown", "tx": "5TKhYsPcH8QFoGtXxqRVKCsJfvePgFxUTAXaF7V8vuG", "what": "a payment allowed inside its task", "row": 372 }
          ]
        },
        {
          "n": "1.7",
          "kind": "term",
          "text": "A plain transfer to the pool cannot move the share price.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 3, "to": 5, "has": "a plain transfer to the contract cannot move the share price", "name": "own accounting fields" },
            { "role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 387, "to": 390, "has": "fn assets_at", "name": "assets_at" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 179, "has": "fn a_plain_transfer_to_the_contract_cannot_move_the_share_price", "name": "a_plain_transfer_to_the_contract_cannot_move_the_share_price" }
          ]
        },
        {
          "n": "1.8",
          "kind": "term",
          "text": "Deposits and withdrawals price a share the same way, and every rounding goes in the pool's favour.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 599, "has": "shares_for_deposit", "name": "deposit" },
            { "role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 633, "to": 635, "has": "amount_for_shares", "name": "withdraw" },
            { "role": "Enforced", "file": "contracts/airlock-credit/src/math.rs", "line": 54, "to": 70, "has": "pub fn amount_for_shares", "name": "share math" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/math.rs", "line": 247, "has": "fn withdraw_rounds_down_and_never_pays_more_than_pro_rata", "name": "withdraw_rounds_down_and_never_pays_more_than_pro_rata" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/math.rs", "line": 258, "has": "fn deposit_then_withdraw_never_gains", "name": "deposit_then_withdraw_never_gains" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 1316, "has": "fn property_random_operations_keep_the_accounting", "name": "property_random_operations_keep_the_accounting" },
            { "role": "Shown", "tx": "5qLww3EW9EfCJnZ5kkhs4BCzzskw3doYFabYMJ34agEs", "what": "a lender's 3 NEAR withdrawn as 3.03 NEAR", "row": 380 }
          ]
        },
        {
          "n": "1.9",
          "kind": "term",
          "text": "An overdue line counts as zero in the share price before anyone calls default, and deposits stay closed while a line is overdue or a loss is unrecovered.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 372, "to": 379, "has": "fn impaired_at", "name": "impaired_at" },
            { "role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 585, "to": 592, "has": "deposits are paused", "name": "deposit" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 1002, "has": "fn an_overdue_line_is_impaired_in_the_share_price_before_anyone_calls_default", "name": "an_overdue_line_is_impaired_in_the_share_price_before_anyone_calls_default" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 657, "has": "fn deposits_are_refused_while_a_line_is_past_due_and_reopen_after_default", "name": "deposits_are_refused_while_a_line_is_past_due_and_reopen_after_default" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 894, "has": "fn deposits_stay_closed_between_a_default_and_its_recovery", "name": "deposits_stay_closed_between_a_default_and_its_recovery" },
            { "role": "Shown", "tx": "5n4ZoQW6fe5KSd7SqNunDWwRQhe4xLepH5ZmjfH9dgon", "what": "a deposit refused while a line was past due", "row": 383 },
            { "role": "Shown", "tx": "6Hzfv7JbAobTBbNMr7x8PuuCbDgN3JQt5y5Xg4w6eTQs", "what": "a deposit refused before a loss was recovered", "row": 385 }
          ]
        },
        {
          "n": "1.10",
          "kind": "term",
          "text": "A lender's shares can be withdrawn by that lender alone, once the hold has passed, from money the pool holds idle.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 618, "to": 641, "has": "pub fn withdraw", "name": "withdraw" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 195, "has": "fn withdraw_pays_the_pro_rata_amount_down_to_idle_and_refuses_beyond", "name": "withdraw_pays_the_pro_rata_amount_down_to_idle_and_refuses_beyond" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 957, "has": "fn shares_are_held_for_min_hold_ms_after_a_deposit", "name": "shares_are_held_for_min_hold_ms_after_a_deposit" },
            { "role": "Shown", "tx": "5qLww3EW9EfCJnZ5kkhs4BCzzskw3doYFabYMJ34agEs", "what": "a lender withdraws all its shares", "row": 380 }
          ]
        },
        {
          "n": "1.11",
          "kind": "term",
          "text": "On default the collateral pays the principal before the fee, and what it does not cover is a loss to the lenders.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 1123, "to": 1160, "has": "pub fn default", "name": "default" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 752, "has": "fn default_seizes_collateral_principal_first_and_books_the_rest_as_a_loss", "name": "default_seizes_collateral_principal_first_and_books_the_rest_as_a_loss" },
            { "role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 774, "has": "fn default_with_collateral_above_what_is_owed_returns_the_rest", "name": "default_with_collateral_above_what_is_owed_returns_the_rest" },
            { "role": "Shown", "tx": "6Pk6PR71dnoPJGjxy1CpQWNGkdgE6a7DmEec5ZnJQcxA", "what": "a default: collateral seized, the rest a loss", "row": 384 }
          ]
        },
        {
          "n": "1.12",
          "kind": "term",
          "text": "A lender with no entry in the pool pays 0.0025 NEAR for that entry in the pool's storage, out of the amount attached to its deposit; the pool credits the rest, which must be at least 0.001 NEAR. The charge is not pool money and is not refunded, and withdrawing every share removes the entry.",
          "status": "in force",
          "refs": [
            {"role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 33, "to": 36, "has": "pub const LP_STORAGE", "name": "LP_STORAGE"},
            {"role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 593, "to": 597, "has": "LP_STORAGE", "name": "deposit"},
            {"role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 642, "to": 646, "has": "self.locks.remove(&who)", "name": "withdraw"},
