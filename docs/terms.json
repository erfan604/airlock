        {
          "n": "2.6",
          "kind": "limit",
          "text": "Lenders can leave 60 seconds after a deposit on this pool, and then for as much as the pool holds idle; money lent out waits for its repayment. Collateral is 30 percent of a line, and the pool bears any loss beyond it.",
          "status": "in force",
          "refs": [
            { "role": "Enforced", "file": "contracts/airlock-credit/src/lib.rs", "line": 639, "to": 643, "has": "insufficient idle liquidity", "name": "withdraw" },
