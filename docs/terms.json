            {"role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 285, "has": "fn a_first_deposit_must_cover_the_minimum_and_the_charge", "name": "a_first_deposit_must_cover_the_minimum_and_the_charge"},
            {"role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 303, "has": "fn the_storage_charge_never_moves_the_share_price", "name": "the_storage_charge_never_moves_the_share_price"},
            {"role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 328, "has": "fn a_full_withdraw_removes_both_entries_and_a_partial_keeps_them", "name": "a_full_withdraw_removes_both_entries_and_a_partial_keeps_them"},
