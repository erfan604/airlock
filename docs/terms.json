            { "role": "Tested", "file": "contracts/airlock-credit/src/tests.rs", "line": 2528, "has": "fn the_base_check_fee_cannot_move_the_share_price", "name": "the_base_check_fee_cannot_move_the_share_price" },
            { "role": "Shown", "tx": "4aMpo4V2949S9Pp25GvxwrLa7x2Fb7zKjAr9crFpgqMz", "what": "the pool records the signed answer for a Base Sepolia payment", "row": 466 },
            { "role": "Shown", "tx": "8KReKRKbYWAdmRz1dcRmw5rqR41tzhkzz75N31mLzGbQ", "what": "the pool records the signed answer for the card's own Base payment", "row": 512 }
          ]
        },
        {
          "n": "2.11",
          "kind": "limit",
          "text": "The issuer registers the cards, and the pool checks a card by the answer the card account gives to get_roles: owner, approver and sponsor. The pool does not read the card's code, so the issuer can register a contract that is not an AIRLOCK card and that gives that answer.",
          "status": "in force",
          "refs": [
